<Project Sdk="Microsoft.NET.Sdk">
  <!-- 半亩方塘 for Windows: .NET Framework 4.8 (part of every Windows 10 and 11) + WebView2 (Edge's engine, also
       preinstalled), so the download is small and nothing else needs installing. Builds on Linux too. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SkyPond</AssemblyName>
    <RootNamespace>SkyPond</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 版本号唯一来源是仓库根目录的 version.json：scripts/build-windows.sh 会以 -p:Version 覆盖这里；
         这一行只是没走脚本时的兜底，改版本请改 version.json（node scripts/version.mjs check 会校验）。 -->
    <Version>1.2.0</Version>
    <Product>半亩方塘</Product>
    <AssemblyTitle>半亩方塘 · 锦鲤池塘动态壁纸</AssemblyTitle>
    <Copyright>半亩方塘 · 基于「碧池观鱼」二次创作</Copyright>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <!-- The pond itself: the same web files as every other build, served to WebView2 from a web\ folder. -->
  <ItemGroup>
    <Content Include="..\..\index.html;..\..\style.css;..\..\core.js;..\..\art.js;..\..\gl.js;..\..\scene.js;..\..\now.js;..\..\audio.js;..\..\app.js" Link="web\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\pond.webp;..\..\assets\pond-spring.webp;..\..\assets\pond-summer.webp;..\..\assets\pond-autumn.webp;..\..\assets\pond-winter.webp;..\..\assets\pond-data.js;..\..\assets\favicon.svg" Link="web\assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
