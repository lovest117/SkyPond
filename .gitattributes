# Auto-detect text files; normalize to LF in the repo.
* text=auto

# Shell scripts must stay LF — Linux runners cannot execute CRLF shebangs.
*.sh    text eol=lf
*.bash  text eol=lf

# Common web/config sources.
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.csproj text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf

# Windows-native files keep CRLF on checkout.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binaries.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.webp  binary
*.apk   binary
*.zip   binary
*.mp4   binary
*.woff  binary
*.woff2 binary
